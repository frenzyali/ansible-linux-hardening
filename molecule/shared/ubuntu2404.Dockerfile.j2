# Test image only: Ubuntu 24.04 with systemd as PID 1 and Python for Ansible.
# Nothing security-related is preinstalled; the roles must install what they need.
FROM ubuntu:noble-20260917

ENV DEBIAN_FRONTEND=noninteractive \
    container=docker

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      systemd systemd-sysv python3 python3-apt sudo ca-certificates iproute2 \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/* \
 && rm -f /lib/systemd/system/multi-user.target.wants/getty* \
          /lib/systemd/system/sysinit.target.wants/systemd-firstboot.service

STOPSIGNAL SIGRTMIN+3
CMD ["/lib/systemd/systemd"]

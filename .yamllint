---
extends: default

yaml-files:
  - '*.yaml'
  - '*.yml'
  - '*.yml.example'
  - .yamllint

ignore: |
  .venv/
  .ansible/

rules:
  line-length:
    max: 160
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false      # GitHub Actions uses the bare key "on:"
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  indentation:
    indent-sequences: consistent
